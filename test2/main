import sys
from PyQt6.QtCore import Qt, QDate
from PyQt6.QtWidgets import QApplication, QVBoxLayout, QLabel

from arceion.qt.core import Window, View
from arceion.qt.util import UI
from arceion.qt.contrib.enums import FontWeight
from arceion.qt.contrib.styles.Label import label
from arceion.qt.contrib.widgets.Attr import Margin
from arceion.qt.contrib.widgets.DatePicker import DatePicker


class HomeView(View):
    def __init__(self, parent: Window | None = None, name: str | None = None):
        super().__init__(parent, name)

        self.mainLayout = QVBoxLayout(self)
        self.mainLayout.setContentsMargins(Margin(horizontal=UI.dp(60), vertical=UI.dp(40)))
        self.mainLayout.setSpacing(UI.dp(20))
        self.mainLayout.setAlignment(Qt.AlignmentFlag.AlignLeading | Qt.AlignmentFlag.AlignTop)

        # --- Default ---
        self.defaultLabel = QLabel('# Default')
        self.defaultLabel.setStyleSheet(label.update(
            fontSize=UI.sp(16),
            fontWeight=FontWeight.SemiBold,
        ).qss)
        self.picker = DatePicker()

        # --- With Initial Date ---
        self.initialLabel = QLabel('# With Initial Date')
        self.initialLabel.setStyleSheet(label.update(
            fontSize=UI.sp(16),
            fontWeight=FontWeight.SemiBold,
        ).qss)
        self.pickerWithDate = DatePicker(
            date=QDate.currentDate(),
        )

        # --- Custom Format ---
        self.formatLabel = QLabel('# Custom Format (yyyy-MM-dd)')
        self.formatLabel.setStyleSheet(label.update(
            fontSize=UI.sp(16),
            fontWeight=FontWeight.SemiBold,
        ).qss)
        self.pickerCustomFormat = DatePicker(
            dateFormat='yyyy-MM-dd',
            placeholder='Select a date',
        )

        # --- Custom Placeholder ---
        self.placeholderLabel = QLabel('# Custom Placeholder')
        self.placeholderLabel.setStyleSheet(label.update(
            fontSize=UI.sp(16),
            fontWeight=FontWeight.SemiBold,
        ).qss)
        self.pickerPlaceholder = DatePicker(
            placeholder='Choose your birthday',
        )

        # add to layout
        self.mainLayout.addWidget(self.defaultLabel)
        self.mainLayout.addWidget(self.picker, alignment=Qt.AlignmentFlag.AlignLeft)
        self.mainLayout.addWidget(self.initialLabel)
        self.mainLayout.addWidget(self.pickerWithDate, alignment=Qt.AlignmentFlag.AlignLeft)
        self.mainLayout.addWidget(self.formatLabel)
        self.mainLayout.addWidget(self.pickerCustomFormat, alignment=Qt.AlignmentFlag.AlignLeft)
        self.mainLayout.addWidget(self.placeholderLabel)
        self.mainLayout.addWidget(self.pickerPlaceholder, alignment=Qt.AlignmentFlag.AlignLeft)

        self.setLayout(self.mainLayout)

    def onCreate(self) -> None:
        self.picker.onDateChanged(
            lambda date: print(f"[Default] Selected: {date.toString('yyyy-MM-dd')}")
        )
        self.pickerWithDate.onDateChanged(
            lambda date: print(f"[Initial Date] Selected: {date.toString('yyyy-MM-dd')}")
        )
        self.pickerCustomFormat.onDateChanged(
            lambda date: print(f"[Custom Format] Selected: {date.toString('yyyy-MM-dd')}")
        )
        self.pickerPlaceholder.onDateChanged(
            lambda date: print(f"[Placeholder] Selected: {date.toString('yyyy-MM-dd')}")
        )

    def onResume(self) -> None:
        pass

    def onDestroy(self) -> bool:
        return super().onDestroy()


class MainWindow(Window):
    def __init__(self):
        super().__init__()
        self.setObjectName('MainWindow')
        self.setWindowTitle('Test DatePicker')
        self.resize(800, 600)
        self.setStyleSheet("background-color: black;")
        self.navigate(HomeView)
        self.show()


if __name__ == '__main__':
    app = QApplication(sys.argv)
    window = MainWindow()
    sys.exit(app.exec())